<iq:manifest xmlns:iq="http://www.garmin.com/xml/connectiq" version="3">
    <!--
      type="audio-content-provider-app" is what makes this show up under the
      watch's Music Providers rather than as an ordinary app. It is also the
      only app type allowed to write into the device's encrypted media store.

      Communications is the sole permission: the app talks to the user's music
      server, and to the Tracks phone app over the Bluetooth link. Notably
      absent is Background: a five-minute poll of the phone was built and
      dropped, because a Bluetooth round trip every five minutes, all day,
      is battery spent to learn — nearly every time — that nothing changed.
      The app asks on every open and before every sync instead. Also absent
      is any Garmin service — this app is installed straight from the Tracks
      phone app over Bluetooth and syncs over the watch's own Wi-Fi, so the
      Connect IQ Store is never involved.
    -->
    <iq:application
        entry="TracksMusicApp"
        id="821c220f1cb24c338d2c68b3dafb1d3f"
        launcherIcon="@Drawables.LauncherIcon"
        name="@Strings.AppName"
        type="audio-content-provider-app"
        minApiLevel="3.0.0">

