# Development settings for docker-compose.yml. ./setup.sh copies this to .env
# with generated secrets. (Installs from the released image need none of it.)
# Never commit .env to git

# Database
POSTGRES_USER=tracks
POSTGRES_PASSWORD=changeme
POSTGRES_DB=tracks
DATABASE_URL=postgresql://tracks:changeme@db:5432/tracks

# Path on YOUR machine for encrypted FIT blob storage (backend/app/services/
# object_storage.py). Purely internal — activities get here via the web
# upload page or a paired sync agent (Settings > Sync Agents), never by
# dropping files into this folder by hand; what's on disk is ciphertext only.
HOST_FIT_DIR=./fit-files

# User and group IDs for file ownership inside the backend container.
# Match your host user so downloaded map tiles are writable from the host too.
# Find your IDs with:  id -u && id -g
HOST_UID=1000
HOST_GID=1000

# Path on YOUR machine for map data (PMTiles basemap, BRouter routing tiles).
# Grows over time as you download regions.
# On Unraid/NAS, set this to a path outside the Docker app folder.
HOST_MAPDATA_DIR=./map-data

# Path on YOUR machine for garmin-sync's own private bookkeeping (which
# files it's already synced, the AGPS ephemeris cache). Only used if you
# enable the garmin profile below. Small, and never shared with the backend
# — garmin-sync doesn't touch HOST_FIT_DIR at all.
HOST_GARMIN_SYNC_DIR=./garmin-sync-data

# App
# REQUIRED in production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# setup.sh fills this in. The app refuses to start without it (or with a
# placeholder), so a .env copied from this file by hand fails loudly.
JWT_SECRET=
DEBUG=false

# REQUIRED in production. Encrypts AI provider API keys at rest (Fernet).
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WARNING: rotating this key invalidates every encrypted AI key stored in the
# database — users will need to re-enter their AI provider credentials.
ENCRYPTION_KEY=

# Allowed CORS origins (comma-separated). Default allows the local frontend only.
# For remote access, add your server's URL, e.g. CORS_ORIGINS=https://tracks.example.com
# CORS_ORIGINS=http://localhost:3000

# Garmin device sync — generated by setup.sh. Since garmin-sync only ever
# runs on this same host, the backend pre-authorizes it for the admin
# account automatically during onboarding (on by default, toggle in the
# setup wizard) — no manual pairing step. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
GARMIN_SYNC_BOOTSTRAP_TOKEN=

# Session-scoped decryption-key cache (backend/app/services/crypto_context.py).
# Points at the redis service defined in docker-compose.yml — only change
# this if you're running Redis somewhere else.
REDIS_URL=redis://redis:6379/0

# REQUIRED in production. Encrypts each logged-in user's decryption key while
# it's cached in Redis for their session. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unlike ENCRYPTION_KEY, rotating this is harmless — it just forces everyone
# to log in again; no stored data depends on it.
SESSION_CACHE_KEY=

# ─────────────────────────────────────────
# Self-hosted vector basemap (Protomaps v4)
# ─────────────────────────────────────────
# Public Protomaps planet build used as source for per-region basemap extracts.
# Builds rotate roughly weekly; bump the date if downloads 404.
# Leave empty to skip basemap downloads (map won't render without tiles).
PMTILES_SOURCE_URL=https://build.protomaps.com/YYYYMMDD.pmtiles

# ─────────────────────────────────────────
# Terrain DEM tiles for hillshade + 3D terrain
# ─────────────────────────────────────────
# Mapterhorn global Terrain-RGB tileset covering z0-15.
# Used for hillshade rendering, 3D terrain, and contour generation.
# The planet.pmtiles is ~15GB; only z0-7 is downloaded globally (~3GB),
# and per-region z7-15 extracts are downloaded on demand.
# Leave empty to skip hillshade/terrain features.
DEM_SOURCE_URL=https://download.mapterhorn.com/planet.pmtiles

# ─────────────────────────────────────────
# Stack tuning
# ─────────────────────────────────────────
# Port the web interface is published on.
# TRACKS_PORT=4080

# Have a Garmin device? Enable the USB sync container (it needs access to
# /dev/bus/usb, so it only runs when you opt in):
# COMPOSE_PROFILES=garmin

# Backend worker processes (default 4). Raise on big hardware; keep
# workers × 10 under Postgres max_connections (100).
# UVICORN_WORKERS=4

# Celery worker concurrency (default 2) — processes the task queue (see
# backend/app/tasks/), currently just draining sync-agent-ingested FIT
# imports after login. Raise on big hardware / many concurrent users.
# CELERY_CONCURRENCY=2
