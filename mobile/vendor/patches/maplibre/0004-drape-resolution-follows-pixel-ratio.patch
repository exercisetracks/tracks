diff --git a/src/mbgl/renderer/renderer_impl.hpp b/src/mbgl/renderer/renderer_impl.hpp
index e53af67..70a4cae 100644
--- a/src/mbgl/renderer/renderer_impl.hpp
+++ b/src/mbgl/renderer/renderer_impl.hpp
@@ -2,6 +2,9 @@
 
 #include <mbgl/renderer/render_orchestrator.hpp>
 #include <mbgl/renderer/texture_pool.hpp>
+
+#include <algorithm>
+#include <cmath>
 #include <mbgl/gfx/context_observer.hpp>
 
 #if MLN_RENDER_BACKEND_METAL
@@ -65,9 +68,24 @@ private:
     // 1) draped roads look aliased because the line AA band, sized to the screen's device
     // pixel ratio, falls sub-texel in the lower-resolution target. Lower drapeQualityFactor
     // back to 1 to save GPU memory on constrained devices (each step is 4x memory/target).
+    //
+    // The factor follows the device pixel ratio rather than being fixed at 2.
+    // A fixed 1024 target is right for a 1x display, where one 512-unit tile is
+    // 512 device pixels and the drape is a 2x supersample of it. On a phone at
+    // 3.5x that same tile covers ~1800 device pixels, so a 1024 target is
+    // *magnified* on the way to the screen and every draped layer — fills,
+    // lines, hillshade — comes out visibly soft. Symbols are not draped, which
+    // is why labels stay crisp and the blur reads as a mysterious loss of
+    // sharpness rather than as a resolution problem.
+    //
+    // Capped at 3 (1536x1536, ~9 MB a target) rather than tracking the ratio
+    // exactly: 4 would be 16 MB each and, across a viewport's worth of tiles,
+    // more GPU memory than a map is worth.
     static constexpr uint32_t drapeTileSize = 512;
-    static constexpr uint32_t drapeQualityFactor = 2;
-    TexturePool texturePool{drapeTileSize * drapeQualityFactor};
+    static uint32_t drapeQualityFactor(float pixelRatio) {
+        return std::clamp(static_cast<uint32_t>(std::ceil(pixelRatio)), 2u, 3u);
+    }
+    TexturePool texturePool;
 
     gfx::RendererBackend& backend;
 
