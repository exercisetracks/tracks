         consumerProguardFiles("proguard-rules.pro")
+        // Tracks: remap the checkout's absolute path. Assertions and log lines
+        // embed __FILE__, so without this the .so carries the path of whoever
+        // built it (home directory and all) into every APK that bundles it.
+        externalNativeBuild {
+            cmake {
+                val checkout = rootProject.projectDir.parentFile.parentFile.absolutePath
+                cFlags("-ffile-prefix-map=$checkout=.")
