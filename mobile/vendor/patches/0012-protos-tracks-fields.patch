 message FileSyncService {
   optional FileRequest file_request = 1;
   optional FileResponse file_response = 2;
-  optional Message4 unk4 = 4;
-  optional TransferStatusRequest transfer_status_request = 5;
+  // Tracks-local, not upstream: captured from Garmin Connect pushing a training
+  // calendar. This is how Garmin uploads — NOT the legacy GFDI CREATE_FILE /
+  // UPLOAD_REQUEST / FILE_TRANSFER_DATA path. See AGENTS.md.
+  optional UploadRequest upload_request = 3;
+  optional UploadResponse upload_response = 4;
+  // Tracks-local, not upstream. The watch reports the end of every transfer
+  // with this and waits for the response below before moving on. Garmin
+  // Connect answers all 22 of them in a single sync; Tracks answered none,
+  // which is why an upload the watch had accepted never went anywhere.
+  optional TransferComplete transfer_complete = 5;
+  optional TransferCompleteResponse transfer_complete_response = 21;
+  // Upstream (0.94+) calls 4 Message4, 5 TransferStatusRequest and 21
+  // TransferStatusResponse, and answers 5 with {1: 1}. They are the same wire
+  // messages as the captured ones above, and Connect answers with 34 (empty
+  // at the end of a burst), which is what made calendar pushes land; so these
+  // names and that answer stand. See FileSyncServiceHandler.handleTransferComplete.
   optional Message7 unk7 = 7;
   optional FileListRequest file_list_request = 9;
   optional FileListResponse file_list_response = 10;
@@ -19,7 +33,6 @@ message FileSyncService {
   optional FileUpdateNotification file_update_notification = 17;
   optional Message19 unk19 = 19;
   optional Notification20 notification20 = 20;
-  optional TransferStatusResponse transfer_status_response = 21;
   optional StartSyncNotification start_sync_notification = 22;
   optional Message24 unk24 = 24;
 
@@ -92,6 +105,50 @@ message FileUpdateNotification {
   optional FileId flags_removed = 3;
 }
 
+// Ask the watch to accept a new file. The watch answers UploadResponse with a
+// transfer handle, and the bytes then go over a separate multi-link file
+// transfer service rather than through GFDI messages.
+message UploadRequest {
+  optional File file = 1;
+  optional uint32 unk2 = 2; // 34
+  optional uint32 unk3 = 3; // 0
+  optional uint32 unk4 = 4; // 15
+}
+
+message UploadResponse {
+  optional uint32 status = 1; // 0 = accepted
+  optional uint32 unk2 = 2;   // 0
+  optional uint32 unk3 = 3;   // 0
+  optional uint32 handle = 4; // transfer handle, incrementing
+  optional uint32 unk8 = 8;   // 10
+}
+
+// Watch -> phone, once per transfer, naming the file and the handle it ran on.
+// Sent for files the watch received as well as files it sent.
+//
+// unk3..unk6 are NOT a verdict on the file, though they read like one for a
+// while. Across seventeen consecutive successful uploads they alternated
+// strictly by handle parity -- {3=0, 4=4, 5=10, 6=3} and {3=0, 4=12, 5=5, 6=3}
+// -- with the same FIT type landing on both sets, and they were byte-identical
+// before and after the schedule was re-encoded from scratch. Whatever they
+// describe belongs to the transfer channel, not the content. An earlier note
+// here read them as a failure report on the strength of two samples that
+// happened to fall on opposite parities; they are not.
+message TransferComplete {
+  optional FileId file = 1;
+  optional uint32 handle = 2;
+  optional uint32 unk3 = 3;
+  optional uint32 unk4 = 4;
+  optional uint32 unk5 = 5;
+  optional uint32 unk6 = 6;
+}
+
+// The answer the watch is waiting for. Connect always sends 34 here, the same
+// constant it puts in UploadRequest.unk2.
+message TransferCompleteResponse {
+  optional uint32 unk1 = 1; // 34
+}
+
 message FileRequest {
   optional File file = 1;
   optional uint32 unk2 = 2; // 24
