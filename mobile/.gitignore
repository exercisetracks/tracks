build/
.gradle/
# Kotlin compiler daemon session files — build scratch, per-machine.
.kotlin/

# The Gradle wrapper JAR is committed on purpose. Every Android project ships
# it, F-Droid's build recipe expects it, and without it `./gradlew` cannot
# bootstrap on a fresh checkout — which is the whole point of the wrapper.
!gradle/wrapper/gradle-wrapper.jar

# Points at this machine's SDK. Generated by Android Studio / written by hand;
# never committed, because the path is not the same on any two machines.
local.properties
