#
# Tracks settings for compose.yaml. Save as `.env` beside it; every line is
# optional, and a missing one takes the default shown. Run
# `docker compose up -d` after a change.

# Port Tracks is reachable on, at http://<this machine>:4080.
TRACKS_PORT=4080

# Where data is kept: a Docker volume name, or a folder on this machine.
#   TRACKS_DATA  database, generated secrets and the original watch files.
#                Small. Back it up: docker exec tracks tracks-backup > tracks.tar.gz
#   TRACKS_MAPS  offline maps and routing tiles. At least 20 GB once maps are
#                turned on, more per region; point it at a big disk if you
#                have one, e.g. /mnt/storage/tracks-maps
TRACKS_DATA=tracks-data
TRACKS_MAPS=tracks-maps

# Owner of the files Tracks writes into those folders, when they are folders.
# `id -u` and `id -g` print yours.
HOST_UID=1000
HOST_GID=1000

# true when your own reverse proxy (Caddy, nginx, Traefik…) sits in front of
# Tracks, so login rate limiting sees real client addresses.
BEHIND_PROXY=false
