#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 Hawk Fugagli
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# First thing the container runs (as root, under tini): prepare /data, then
# hand over to the supervisor. Everything here is idempotent, so a restart
# runs it again harmlessly.
set -euo pipefail

# ── Secrets ───────────────────────────────────────────────────────────────────
# Generated once, per install, on first start. The backend refuses to start on
# a missing secret precisely so that no install can run on a value published
# in this repository; a value drawn here from the OS CSPRNG is unique to this
# volume, which keeps that guarantee without asking anyone to run a script.
#
# They live in /data beside the database they protect. That is deliberate:
# ENCRYPTION_KEY without the database is useless and the database without it
# loses its stored AI keys, so they must be backed up together (tracks-backup
# does). It also means a copy of /data holds the keys — protect it as you
# would the health records in it. Mode 600, root-owned; each service reads
# them at start through env.sh.
if [ ! -s /data/secrets.env ]; then
    mkdir -p /data
    umask 077
    python3 - > /data/secrets.env.tmp <<'PY'
import base64, os, secrets
print("# Generated by tracks-init on first start. Back up with the database.")
print(f"JWT_SECRET={secrets.token_urlsafe(48)}")
print(f"ENCRYPTION_KEY={base64.urlsafe_b64encode(os.urandom(32)).decode()}")
print(f"SESSION_CACHE_KEY={secrets.token_urlsafe(32)}")
print(f"POSTGRES_PASSWORD={secrets.token_urlsafe(24)}")
print(f"GARMIN_SYNC_BOOTSTRAP_TOKEN={secrets.token_urlsafe(32)}")
PY
    mv /data/secrets.env.tmp /data/secrets.env
    umask 022
    echo "[tracks-init] generated secrets in /data/secrets.env"
fi

# Everything that needs the secrets runs in a subshell, so none of them is in
# the environment the supervisor — and so every service — inherits. That
# matters: env.sh lets a value already in the environment override the file
# (that is how an operator's -e wins), so a secret leaked in from here would
# pin every service to the values of the moment the container started, and a
# tracks-restore that replaced the file would be ignored until a restart.
(
# shellcheck source=/usr/local/lib/tracks/env.sh
. /usr/local/lib/tracks/env.sh

mkdir -p /data/fit-files /data/caddy /data/caddy-config /data/garmin-sync /map-data /run/postgresql
chown postgres:postgres /run/postgresql
chown "$RUN_UID:$RUN_GID" /data/fit-files /data/caddy /data/caddy-config /data/garmin-sync

# ── Database ──────────────────────────────────────────────────────────────────
# A cluster of its own in /data/postgres, owned by the postgres system user.
# The superuser is "tracks", as with the postgres image the development stack
# uses. Connections over TCP (the backend, on 127.0.0.1 only) need the
# password; the Unix socket is trusted, because the only things that can reach
# it are processes in this container — anyone able to `docker exec` here is
# root in it already and could read the data files directly. That is what
# lets tracks-backup and tracks-restore work without a password.
if [ ! -s "$PGDATA/PG_VERSION" ]; then
    echo "[tracks-init] creating the database"
    install -d -o postgres -g postgres -m 700 "$PGDATA"
    pwfile="$(mktemp)"
    printf '%s\n' "$POSTGRES_PASSWORD" > "$pwfile"
    chown postgres "$pwfile"
    gosu postgres "$PGBIN/initdb" -D "$PGDATA" -U tracks --pwfile="$pwfile" \
        --auth-local=trust --auth-host=scram-sha-256 -E UTF8 --locale=C.UTF-8 >/dev/null
    rm -f "$pwfile"
    gosu postgres "$PGBIN/pg_ctl" -D "$PGDATA" -o "-c listen_addresses=''" -w -s start
    gosu postgres "$PGBIN/createdb" -U tracks tracks
    gosu postgres "$PGBIN/pg_ctl" -D "$PGDATA" -m fast -w -s stop
fi
if [ "$(cat "$PGDATA/PG_VERSION")" != 16 ]; then
    echo "[tracks-init] /data/postgres was made by PostgreSQL $(cat "$PGDATA/PG_VERSION"), this image runs 16." >&2
    echo "[tracks-init] Restore a tracks-backup into a fresh volume instead (see the README)." >&2
    exit 1
fi
)

# ── USB watch bridge ──────────────────────────────────────────────────────────
# Only when the USB bus was passed in (README, "Over USB"). Without it the
# bridge has nothing to talk to, and an install that never asked for USB
# access should not run a process that wants it.
mkdir -p /etc/tracks/conf.d
rm -f /etc/tracks/conf.d/garmin-sync.conf
if [ -d /dev/bus/usb ] && [ "${TRACKS_USB_SYNC:-auto}" != off ]; then
    ln -s /etc/tracks/garmin-sync.conf /etc/tracks/conf.d/garmin-sync.conf
    echo "[tracks-init] USB bus present: starting the watch bridge"
fi

exec supervisord -n -c /etc/tracks/supervisord.conf
